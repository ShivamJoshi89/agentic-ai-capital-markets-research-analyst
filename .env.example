# OpenAI API (Get from https://platform.openai.com/api-keys)
# Needed for Phase 4 memo generation
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# API KEYS - OPTIONAL BUT RECOMMENDED
# ============================================

# FRED API (Get from https://fred.stlouisfed.org/docs/api/#api_key)
# Free tier for macroeconomic data
FRED_API_KEY=your_fred_api_key_here

# NewsAPI (Get from https://newsapi.org/)
# Optional: Enhanced news collection
NEWS_API_KEY=your_newsapi_key_here

# SEC EDGAR (no key needed, but a descriptive User-Agent is required by SEC's
# fair-access policy - requests without one get throttled/blocked)
# https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT=Your Name your_email@example.com

# ============================================
# APPLICATION SETTINGS
# ============================================

# "production" enables error-message sanitization (no internals leaked to the
# client). Leave as "development" locally.
APP_ENV=development
LOG_LEVEL=INFO

# ============================================
# PUBLIC DEPLOYMENT (backend / Railway)
# ============================================

# Comma-separated allowed CORS origins. MUST be set to the real frontend
# origin(s) in production (the Vercel URL) - never a wildcard. Default covers
# local Vite/CRA dev.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Per-IP rate limit for POST /api/analyze (slowapi format "<count>/<period>").
ANALYZE_RATE_LIMIT=5/minute

# Number of trusted proxies in front of the app. The real client IP is taken
# this many entries from the RIGHT of X-Forwarded-For (the value the proxy
# appended), so a client-supplied left prefix can't be spoofed for a fresh
# rate-limit bucket. Railway's edge = 1; bump only if there are more hops.
TRUSTED_PROXY_COUNT=1

# Global cap on full analyses per UTC day (each triggers a paid LLM memo) -
# bounds worst-case spend even if a single actor rotates IPs.
MEMO_DAILY_CAP=200

# Optional path to persist the daily-cap counter so it survives a restart
# (unset = in-memory, resets on ANY restart). On an ephemeral filesystem it
# survives a process restart but not a redeploy; point it at a mounted Railway
# Volume for full durability across redeploys. Assumes a SINGLE instance - the
# rate-limit, cap, and cache state are all in-process, so run exactly 1 replica.
# DAILY_CAP_STATE_FILE=/data/daily_quota.json

# yfinance result cache TTL in seconds (0 disables). Reduces duplicate Yahoo
# requests for the same ticker across users, lowering rate-limit/block risk.
YF_CACHE_TTL_SEC=1800

# ============================================
# FRONTEND (Vercel) - set in the Vercel project, not here
# ============================================
# VITE_API_URL=https://your-backend.up.railway.app